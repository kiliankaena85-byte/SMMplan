# Database
POSTGRES_DB=smmplan
POSTGRES_USER=smmplan
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://smmplan:CHANGE_ME@db:5432/smmplan?schema=public

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_URL=redis://:CHANGE_ME@redis:6379

# App
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://smmplan.pro
SESSION_SECRET=CHANGE_ME_32_BYTES_RANDOM
WEBHOOK_SECRET=CHANGE_ME_RANDOM

# Payments (реальные ключи)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
ROBOKASSA_LOGIN=
ROBOKASSA_PASS1=
ROBOKASSA_PASS2=

# Dev routes (ДОЛЖНО быть выключено в production)
ENABLE_DEV_ROUTES=false
ENABLE_DEV_BYPASS=false
