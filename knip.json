{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/*.{js,jsx,ts,tsx}"
  ],
  "project": ["src/**/*.{js,jsx,ts,tsx}"],
  "ignore": [
    ".agents/**/*",
    "src/components/ui/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [],
  "ignoreDependencies": [
    "node-fetch",
    "@types/node-fetch"
  ]
}
