# =============================================================================
# 🚀 SMMPLAN / SMMFLUX — ENVIRONMENT CONFIGURATION (v4.0)
# =============================================================================
# Инструкция:
# 1. Скопируйте этот файл: cp .env.example .env
# 2. Заполните [REQUIRED] переменные.
# 3. Для локальной разработки дефолтные значения готовы к использованию.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. СЕТЬ И БАЗА ДАННЫХ [REQUIRED]
# ─────────────────────────────────────────────────────────────────────────────
# Строка подключения PostgreSQL (версия 15+).
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/smmplan_dev"

# URL Redis для очередей задач BullMQ и кэширования Shadow Catalog
REDIS_URL="redis://localhost:6379"

# Порт и базовый URL приложения
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Хосты для мульти-тенантного роутинга (через запятую или в middleware)
NEXT_PUBLIC_SMMPLAN_HOST="smmplan.pro"
NEXT_PUBLIC_SMMFLUX_HOST="smmflux.ru"

# ─────────────────────────────────────────────────────────────────────────────
# 2. КРИПТОГРАФИЯ И АВТОРИЗАЦИЯ [REQUIRED]
# ─────────────────────────────────────────────────────────────────────────────
# Секрет для подписи JWT токенов сессии (генерация: openssl rand -hex 32)
JWT_SECRET="CHANGE_ME_INSECURE_REPLACE_IN_PRODUCTION"  # ⚠️ Run: openssl rand -hex 32
NEXTAUTH_SECRET="CHANGE_ME_INSECURE_REPLACE_IN_PRODUCTION"

# 256-битный ключ шифрования для API-ключей провайдеров и платёжных шлюзов в БД
# Генерация: openssl rand -hex 32 (ровно 64 hex-символа)
APP_ENCRYPTION_KEY="CHANGE_ME_INSECURE_REPLACE_IN_PRODUCTION"  # ⚠️ Run: openssl rand -hex 32  (must be exactly 64 hex chars)

# Соль для детерминированного хэширования данных (email, search tokens)
DATA_SALT="smmplan-dev-data-salt-random-hex-token-2026"

# Секрет для внутренней коммуникации и выполнения фоновых Cron-задач
CRON_SECRET="smmplan-dev-cron-secret-token"
INTERNAL_API_SECRET="smmplan-dev-internal-api-secret"

# ─────────────────────────────────────────────────────────────────────────────
# 3. ТЕСТОВЫЙ РЕЖИМ И SANDBOX (DEV / STAGING)
# ─────────────────────────────────────────────────────────────────────────────
# Ключ для встроенного mock-провайдера (позволяет тестировать заказы без траты реальных денег)
MOCK_PROVIDER_KEY="mock-dev-sandbox-key-2026"

# Включение тестового режима платежей и API
TEST_MODE_ENABLED="false"

# ─────────────────────────────────────────────────────────────────────────────
# 4. ПЛАТЕЖНЫЕ ШЛЮЗЫ И 54-ФЗ (ФИСКАЛИЗАЦИЯ) [OPTIONAL ДЛЯ DEV / REQUIRED В PROD]
# ─────────────────────────────────────────────────────────────────────────────
# ЮKassa (API v3)
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_WEBHOOK_SECRET=""

# Robokassa
ROBOKASSA_MERCHANT_LOGIN=""
ROBOKASSA_PASS_1=""
ROBOKASSA_PASS_2=""

# CryptoBot (Telegram Crypto Pay)
CRYPTOBOT_API_TOKEN=""
CRYPTOBOT_WEBHOOK_SECRET=""

# Фискализация 54-ФЗ (Налоговая реформа 2026):
# НДС: 1 = Без НДС (УСН до 20 млн ₽), 10 = НДС 22% (свыше 20 млн ₽, ФЗ № 425-ФЗ)
FISCAL_DEFAULT_VAT_CODE="1"

# QA & Dev Tools (Strictly Non-production)
ENABLE_QA_TOOLS="false"
QA_DEV_SECRET=""
YOOKASSA_TEST_SECRET_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# 5. ВНЕШНИЕ ПРОВАЙДЕРЫ УСЛУГ (SMM PROVIDERS)
# ─────────────────────────────────────────────────────────────────────────────
# API-ключи внешних поставщиков (для scripts/register-providers.ts)
PROVIDER_KEY_SOC_ROCKET=""
PROVIDER_KEY_SMMPRIME=""
PROVIDER_KEY_STREAM_PROMOTION=""
PROVIDER_KEY_LIKEDROM=""
PROVIDER_KEY_SMMPANELUS=""
PROVIDER_KEY_SOC_PROOF=""
PROVIDER_KEY_TELEGRAM_SHOP=""
PROVIDER_KEY_VEXBOOST=""

# Секреты входящих вебхуков провайдеров (авто-обновление статусов заказов)
VEXBOOST_WEBHOOK_SECRET="YOUR_VEXBOOST_WEBHOOK_SECRET_HERE"  # ⚠️ Get from VexBoost dashboard
PROVIDER_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# 6. УВЕДОМЛЕНИЯ (EMAIL И TELEGRAM БОТ) [OPTIONAL]
# ─────────────────────────────────────────────────────────────────────────────
# SMTP почта для отправки Magic Link и чеков (при пустых значениях логируется в терминал)
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@smmplan.pro"

# Telegram бот поддержки клиентов и Smart Bind (SMMplan / SMMflux)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"  # ⚠️ Get from @BotFather — NEVER commit real tokens
TELEGRAM_WEBHOOK_SECRET=""
BOT_TENANT_ID="smmplan"
FLUX_TELEGRAM_BOT="smmflux_support_bot"

# Telegram бот для алертов администраторам (ошибки, крупные пополнения)
ADMIN_ALERT_BOT_TOKEN=""
ADMIN_ALERT_CHAT_ID=""

# Прокси для Telegram (SOCKS5 / HTTP) — позволяет боту и алертам работать автономно в Docker при выключенном VPN на хосте
# Пример: socks5://user:password@proxy-host:1080 или http://user:password@proxy-host:8080
TELEGRAM_PROXY_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# 7. AI И АВТОМАТИЗАЦИЯ (GEMINI 3) [OPTIONAL]
# ─────────────────────────────────────────────────────────────────────────────
# Google AI Studio API Key (модели gemini-3-flash-preview, gemini-3-flash)
GEMINI_API_KEY=""

# GraphRAG Векторная память (порт 8100 по умолчанию)
GRAPHRAG_API_URL="http://localhost:8100"
