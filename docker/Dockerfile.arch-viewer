# OmniSMM 1.0 Architecture & UML Viewer (Uncle Bob Pattern)
# Ultra-lightweight alpine container (<50MB, zero build overhead)
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3009
ENV HOST=0.0.0.0

# Copy standalone server and public UI assets
COPY tools/arch-viewer /app/tools/arch-viewer

# Run as non-root node user for security
USER node

EXPOSE 3009

CMD ["node", "tools/arch-viewer/server.mjs"]
