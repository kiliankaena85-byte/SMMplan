FROM node:20-alpine
RUN apk add --no-cache libc6-compat openssl curl
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Security: non-root user (AGENTS.md requirement)
RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 nextjs

# Copy pre-built standalone output (built on host via npm run build)
COPY --chown=nextjs:nodejs .next/standalone ./
COPY --chown=nextjs:nodejs .next/static    ./.next/static
COPY --chown=nextjs:nodejs public          ./public

# Copy Prisma query engine and schema
COPY --chown=nextjs:nodejs node_modules/.prisma  ./node_modules/.prisma
COPY --chown=nextjs:nodejs node_modules/@prisma  ./node_modules/@prisma
RUN for d in .next/node_modules/@prisma/client-*; do \
      if [ -e "$d" ] || [ -L "$d" ]; then \
        rm -rf "$d"; \
        cp -r node_modules/@prisma/client "$d"; \
        chown -R nextjs:nodejs "$d"; \
      fi \
    done

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:3000/api/health || exit 1

CMD ["node", "server.js"]
