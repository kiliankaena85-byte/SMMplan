  @@index([providerId])
}

model RoutingAuditLog {
  id             String   @id @default(cuid())
  serviceId      String
  adminId        String?
  action         String // "SWAP", "ADD_ROUTE", "QUARANTINE_REROUTE", "MANUAL_OVERRIDE"
  fromProviderId String?
  toProviderId   String?
  reason         String?
  createdAt      DateTime @default(now())
}

