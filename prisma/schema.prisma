  reviewStatus    String   @default("PENDING") // PENDING | REVIEWED | FLAGGED | VIOLATION | APPROVED
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  staff           User     @relation("staffFinancialActions", fields: [staffUserId], references: [id], onDelete: Restrict)
  target          User     @relation("targetFinancialActions", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([staffUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([ticketId])
  @@index([orderId])
  @@index([reviewStatus])
  @@index([status])
  @@index([tenantId, createdAt])
}

model B2bRequestLog {
  id          String   @id @default(cuid())
  apiKeyHash  String   @map("api_key_hash")
  action      String
  params      Json?
  httpStatus  Int      @map("http_status")
  latencyMs   Int      @map("latency_ms")
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([apiKeyHash, createdAt])
  @@index([createdAt])
  @@map("b2b_request_log")
}

model StaffShift {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation("UserStaffShifts", fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime // Day of the shift at 00:00:00 UTC
  shiftType        String   @default("DAY") // "DAY" (09:00-21:00), "NIGHT" (21:00-09:00), "CUSTOM"
  status           String   @default("PLANNED") // "PLANNED", "COMPLETED", "SWAPPED", "VACATION", "SICK", "DAY_OFF"
  
  // Shift Swap Tracking
  substituteUserId String?
  substituteUser   User?    @relation("ShiftSubstitute", fields: [substituteUserId], references: [id], onDelete: SetNull)
  substituteHours  Float    @default(0) // 0 = полная смена (12ч), > 0 = часы частичной подмены
  
  // Payroll calculation
  rateRubles       Float    @default(2500)
  bonusRubles      Float    @default(0)
  penaltyRubles    Float    @default(0)
  notes            String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, date, shiftType])
  @@index([date, status])
  @@index([userId, date])
}

model PiiAccessLog {
  id         String   @id @default(cuid())
  staffId    String
  staffEmail String
  action     String   // 'view-client', 'view-payment-detail', 'export-csv', etc.
  targetId   String   // client ID / order ID / payment ID
  targetType String   // 'client' | 'order' | 'payment'
  fields     String[] // ['email', 'phone', 'address', 'inn']
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([staffId, createdAt])
  @@index([targetType, targetId])
}

model ProviderServiceBackup {
  id                String   @id @default(cuid())
  serviceId         String   @map("service_id")
  primaryProviderId String   @map("primary_provider_id")
  backupProviderId  String   @map("backup_provider_id")
  backupExternalId  String?  @map("backup_external_id")
  priority          Int      @default(1)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([serviceId, backupProviderId])
  @@index([serviceId, priority])
  @@map("provider_service_backup")
}

model LedgerPeriod {
  id        String        @id @default(cuid())
  month     String        @unique // e.g. "2026-08"
  startDate DateTime      @map("start_date")
  endDate   DateTime      @map("end_date")
  frozen    Boolean       @default(false)
  frozenAt  DateTime?     @map("frozen_at")
  frozenBy  String?       @map("frozen_by")
  entries   LedgerEntry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ledger_period")
}

model RevenueRecognition {
  id             String    @id @default(cuid())
  orderId        String    @unique @map("order_id")
  amount         BigInt    // Amount in Kopecks
  recognizedAt   DateTime  @default(now()) @map("recognized_at")
  reversed       Boolean   @default(false)
  reversedAt     DateTime? @map("reversed_at")
  reversalReason String?   @map("reversal_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("revenue_recognition")
}

model ReconciliationReport {
  id              String   @id @default(cuid())
  date            DateTime
  bankTotal       BigInt   @map("bank_total")
  dbTotal         BigInt   @map("db_total")
  ledgerTotal     BigInt   @map("ledger_total")
  deltaBankVsDb   BigInt   @map("delta_bank_vs_db")
  deltaDbVsLedger BigInt   @map("delta_db_vs_ledger")
  status          String   @default("OK") // OK, MISMATCH
  details         Json?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("reconciliation_report")
}




