{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEARH Risk Schema v1.1",
  "type": "object",
  "required": [
    "risk_id",
    "severity",
    "status"
  ],
  "properties": {
    "risk_id": {
      "type": "string"
    },
    "module": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
    },
    "status": {
      "type": "string",
      "enum": ["OPEN", "CLOSED", "RISK_ACCEPTED", "NEEDS_REMEDIATION"]
    },
    "title": {
      "type": "string"
    },
    "attack_scenario": {
      "type": "string"
    },
    "impact": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "reproduction": {
      "type": "string"
    },
    "recommended_fix": {
      "type": "string"
    },
    "verification_method": {
      "type": "string"
    },
    "closed_by_commit": {
      "type": "string"
    },
    "verification_tests": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
